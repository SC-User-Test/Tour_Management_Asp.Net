@page "{id:int}"
@model TourManagement.Web.Pages.Tours.EditModel
@{
    ViewData["Title"] = "Edit Tour";
}

<h1>Edit Tour</h1>

<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TourName" class="form-label"></label>
                <input asp-for="TourName" class="form-control" />
                <span asp-validation-for="TourName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Place" class="form-label"></label>
                <input asp-for="Place" class="form-control" />
                <span asp-validation-for="Place" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Days" class="form-label"></label>
                <input asp-for="Days" class="form-control" type="number" />
                <span asp-validation-for="Days" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label"></label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Locations" class="form-label"></label>
                <input asp-for="Locations" class="form-control" />
                <span asp-validation-for="Locations" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TourInfo" class="form-label"></label>
                <textarea asp-for="TourInfo" class="form-control" rows="4" maxlength="250"></textarea>
                <span asp-validation-for="TourInfo" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrEmpty(Model.ExistingPictureFileName))
            {
                <div class="mb-3">
                    <label class="form-label">Current Picture</label>
                    <div>
                        <img src="~/uploads/@Model.ExistingPictureFileName" alt="Current" class="img-thumbnail" style="max-width: 200px;" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="PictureFile" class="form-label">New Picture (optional)</label>
                <input asp-for="PictureFile" class="form-control" type="file" accept="image/*" />
                <span asp-validation-for="PictureFile" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
