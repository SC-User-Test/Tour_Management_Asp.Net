@page "{id:int}"
@model TourManagement.Web.Pages.Tours.DetailsModel
@{
    ViewData["Title"] = "Tour Details";
}

<div class="container">
    <h1>Tour Details</h1>
    <hr />

    @if (Model.Tour != null)
    {
        <div class="row">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(Model.Tour.PictureFileName))
                {
                    <img src="~/images/tours/@Model.Tour.PictureFileName" class="img-fluid" alt="@Model.Tour.TourName">
                }
                else
                {
                    <div class="bg-secondary d-flex align-items-center justify-content-center" style="height: 300px;">
                        <span class="text-white">No Image</span>
                    </div>
                }
            </div>
            <div class="col-md-8">
                <dl class="row">
                    <dt class="col-sm-3">Tour Name:</dt>
                    <dd class="col-sm-9">@Model.Tour.TourName</dd>

                    <dt class="col-sm-3">Place:</dt>
                    <dd class="col-sm-9">@Model.Tour.Place</dd>

                    <dt class="col-sm-3">Days:</dt>
                    <dd class="col-sm-9">@Model.Tour.Days</dd>

                    <dt class="col-sm-3">Locations:</dt>
                    <dd class="col-sm-9">@Model.Tour.Locations</dd>

                    <dt class="col-sm-3">Price:</dt>
                    <dd class="col-sm-9">$@Model.Tour.Price.ToString("N2")</dd>

                    <dt class="col-sm-3">Tour Info:</dt>
                    <dd class="col-sm-9">@Model.Tour.TourInfo</dd>

                    <dt class="col-sm-3">Created Date:</dt>
                    <dd class="col-sm-9">@Model.Tour.CreatedDate.ToString("yyyy-MM-dd")</dd>
                </dl>

                <div class="mt-3">
                    <a asp-page="Edit" asp-route-id="@Model.Tour.Id" class="btn btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@Model.Tour.Id" class="btn btn-danger">Delete</a>
                    <a asp-page="/Bookings/Create" asp-route-tourId="@Model.Tour.Id" class="btn btn-success">Book Now</a>
                    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Tour not found.
        </div>
    }
</div>
