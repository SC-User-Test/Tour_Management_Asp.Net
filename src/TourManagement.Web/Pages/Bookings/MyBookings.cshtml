@page
@model MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<div class="row">
    <div class="col-12">
        <h2>My Bookings</h2>

        @if (!string.IsNullOrEmpty(Model.Email))
        {
            @if (Model.Bookings != null && Model.Bookings.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Tour Name</th>
                            <th>Place</th>
                            <th>Booking Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr>
                                <td>@booking.BookingId</td>
                                <td>@booking.TourName</td>
                                <td>@booking.Place</td>
                                <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>You have no bookings yet.</p>
                <a asp-page="/Tours/Index" class="btn btn-primary">Browse Tours</a>
            }
        }
        else
        {
            <div class="alert alert-warning">
                Please <a asp-page="/Account/Login">login</a> to view your bookings.
            </div>
        }
    </div>
</div>
