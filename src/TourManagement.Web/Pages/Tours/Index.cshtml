@page
@model ToursIndexModel
@{
    ViewData["Title"] = "Tours";
}

<div class="row">
    <div class="col-12">
        <h2>Available Tours</h2>
        <a asp-page="/Tours/Create" class="btn btn-primary mb-3">Add New Tour</a>

        @if (Model.Tours != null && Model.Tours.Any())
        {
            <div class="row">
                @foreach (var tour in Model.Tours)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            @if (!string.IsNullOrEmpty(tour.PicturePath))
                            {
                                <img src="~/uploads/@tour.PicturePath" class="card-img-top" alt="@tour.TourName" style="height: 200px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                    No Image
                                </div>
                            }
                            <div class="card-body">
                                <h5 class="card-title">@tour.TourName</h5>
                                <p class="card-text">
                                    <strong>Place:</strong> @tour.Place<br />
                                    <strong>Days:</strong> @tour.Days<br />
                                    <strong>Price:</strong> $@tour.Price
                                </p>
                                <p class="card-text">@tour.TourInfo</p>
                                <div class="d-flex justify-content-between">
                                    <a asp-page="/Tours/Details" asp-route-id="@tour.TourId" class="btn btn-sm btn-info">Details</a>
                                    <a asp-page="/Tours/Edit" asp-route-id="@tour.TourId" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-page="/Bookings/Create" asp-route-tourId="@tour.TourId" class="btn btn-sm btn-success">Book</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>No tours available.</p>
        }
    </div>
</div>
